    {
      "parameters": {
        "jsCode": "const req = $('Prepare & Validate Request').item.json;\n\n// Get all matching requests except the current request\nconst rows = $input.all()\n  .map(i => i.json)\n  .filter(r => r.request_id && r.request_id !== req.request_id);\n\n// If at least one previous matching request exists,\n// treat the new request as a duplicate\nconst duplicate = rows.length > 0;\n\nreturn [{\n  json: {\n    ...req,\n    employee_record: $('Verify Employee').item.json.employee_record,\n    duplicate: duplicate,\n    duplicate_count: rows.length\n  }\n}];"
      },
