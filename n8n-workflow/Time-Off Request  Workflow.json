    {
      "parameters": {
        "jsCode": "const x = $json.body ?? $json;\n\n// Support both n8n field labels and field names\nconst get = (name, label) => x[name] ?? x[label] ?? '';\nconst clean = (value) => String(value || '').trim();\n\nconst employeeId = clean(get('employee_id', 'Employee ID'));\nconst employeeName = clean(get('employee_name', 'Employee name'));\nconst employeeEmail = clean(get('employee_email', 'Employee email'));\nconst departmentId = clean(get('department_id', 'Department ID'));\nconst startDate = clean(get('start_date', 'Start date'));\nconst endDate = clean(get('end_date', 'End date'));\nconst requestType = clean(get('request_type', 'Request type'));\nconst reason = clean(get('reason', 'Reason'));\n\nconst now = new Date();\nconst start = new Date(`${startDate}T00:00:00Z`);\nconst end = new Date(`${endDate}T00:00:00Z`);\n\nconst requestedDays =\n  Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())\n    ? 0\n    : Math.floor((end - start) / 86400000) + 1;\n\nconst allowedTypes = [\n  'Paid Time Off',\n  'Unpaid Time Off',\n  'Sick',\n  'Emergency',\n];\n\nconst errors = [];\n\nif (!employeeId) errors.push('Employee ID is required');\nif (!departmentId) errors.push('Department ID is required');\nif (Number.isNaN(start.getTime())) errors.push('Start date is invalid');\n\nif (Number.isNaN(end.getTime()) || end < start) {\n  errors.push('End date must be on or after start date');\n}\n\nif (!allowedTypes.includes(requestType)) {\n  errors.push('Request type is invalid');\n}\n\nif (requestType === 'Emergency' && !reason) {\n  errors.push('Emergency requests require a reason');\n}\n\nreturn [\n  {\n    json: {\n      request_id:\n        `TOR-${now.toISOString().replace(/[-:.TZ]/g, '').slice(0, 14)}` +\n        `-${Math.random().toString(36).slice(2, 8).toUpperCase()}`,\n\n      deduplication_key: [\n        employeeId,\n        startDate,\n        endDate,\n        requestType,\n      ].join('|'),\n\n      employee_id: employeeId,\n      employee_name: employeeName,\n      employee_email: employeeEmail,\n      department_id: departmentId,\n      start_date: startDate,\n      end_date: endDate,\n      request_type: requestType,\n      reason,\n      status: errors.length ? 'Invalid' : 'Submitted',\n      requested_days: requestedDays,\n      created_at: now.toISOString(),\n      decision_source: errors.length ? 'Validation' : 'Pending',\n      decision_reason: errors.join('; '),\n      n8n_execution_id: $execution.id,\n      decided_at: errors.length ? now.toISOString() : '',\n      valid_input: errors.length === 0,\n      request_date: now.toISOString(),\n    },\n  },\n];"
      },
