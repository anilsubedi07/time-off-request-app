    {
      "parameters": {
        "jsCode": "const req=$('Prepare & Validate Request').item.json; const emp=$('Verify Employee').item.json.employee_record; const dept=$('Find Department').item.json; const requests=$input.all().map(i=>i.json).filter(r=>r.request_id&&r.request_id!==req.request_id); const rs=new Date(req.start_date+'T00:00:00Z'); const re=new Date(req.end_date+'T00:00:00Z'); const notice=Math.floor((rs-new Date(req.request_date))/86400000); const overlapping=requests.filter(r=>r.status==='Approved' && new Date(r.start_date+'T00:00:00Z')<=re && new Date(r.end_date+'T00:00:00Z')>=rs).length; const total=Number(dept.total_employees||0); const pct=total?((overlapping+1)/total):1; const max=Number(dept.max_leave_percent||0.30); let status='Approved', reason='All automatic rules passed', source='Automatic rules'; if(req.request_type==='Emergency'){status='Emergency Review';reason='Emergency requests require a human decision';source='Human approval required';} else if(notice<14){status='Denied – Insufficient Notice';reason=`Submitted ${notice} days before start; 14 required`;source='Notice rule';} else if(['Paid Time Off','Sick'].includes(req.request_type) && Number(emp.leave_balance)<Number(req.requested_days)){status='Denied – Insufficient Balance';reason=`Balance ${emp.leave_balance}; requested ${req.requested_days}`;source='Balance rule';} else if(pct>max){status='HR Review';reason=`Projected department leave ${(pct*100).toFixed(1)}% exceeds ${(max*100).toFixed(0)}%`;source='Department availability rule';} return [{json:{...req,employee_record:emp,department_record:dept,notice_days:notice,overlapping_approved:overlapping,projected_leave_percent:pct,status,decision_reason:reason,decision_source:source,decided_at:status==='Emergency Review'?'':new Date().toISOString()}}];"
      },
